# Dependencies
node_modules/

# Agent build output
agent/dist/
agent/build/

# Desktop (Electron) build output. Only desktop/build/dist is output —
# desktop/build itself is electron-builder's buildResources directory and holds
# checked-in inputs like the app icon.
desktop/out/
desktop/build/dist/

# Expo / Metro
.expo/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Native projects generated by prebuild
/app/ios/
/app/android/

# Local runtime state — contains your pairing code
.lol-remote/

# Environment
.env
.env.local
*.local

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# Editors
.idea/
.vscode/
*.swp
